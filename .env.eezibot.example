# Chatwoot eezibot Deployment Configuration
# Copy this file to .env and fill in your values
# These will be configured in Dokploy environment variables

# Required: Generate with `openssl rand -hex 64`
SECRET_KEY_BASE=

# Your domain (with https://)
FRONTEND_URL=https://eezibot.com

# Postgres Configuration
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatwoot_production

# Redis Configuration
# Format: redis://:PASSWORD@redis:6379
REDIS_URL=
REDIS_PASSWORD=

# Account Signup (true/false/api_only)
ENABLE_ACCOUNT_SIGNUP=true

# Optional: Email Configuration
# MAILER_SENDER_EMAIL=Chatwoot <noreply@eezibot.com>
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=eezibot.com
